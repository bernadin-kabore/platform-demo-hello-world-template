<?xml version="1.0" encoding="UTF-8"?>
<!--
  Structured JSON on stdout, tailed by the otel-collector agent DaemonSet.
  Field names match the collector's json_parser configuration in
  platform-demo-gitops/apps/observability/otel-collector/values-agent.yaml.

  trace_id and span_id come from the MDC, populated by the OpenTelemetry Java
  agent (OTEL_INSTRUMENTATION_LOGBACK_MDC_ENABLED=true in the Dockerfile).
  The collector promotes them to first-class log-record IDs, which is what
  makes the log -> trace pivot work in Grafana.

  Logs are collected from stdout rather than exported by the agent so that a
  JVM crash or OOM kill still leaves readable output - see decision 1 in
  platform-demo-gitops/docs/observability/README.md.
-->
<configuration>
  <appender name="json" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</timestampPattern>
      <fieldNames>
        <timestamp>timestamp</timestamp>
        <level>severity</level>
        <message>message</message>
        <logger>logger</logger>
        <thread>[ignore]</thread>
        <version>[ignore]</version>
        <levelValue>[ignore]</levelValue>
      </fieldNames>
      <includeMdcKeyName>trace_id</includeMdcKeyName>
      <includeMdcKeyName>span_id</includeMdcKeyName>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="json"/>
  </root>
</configuration>
