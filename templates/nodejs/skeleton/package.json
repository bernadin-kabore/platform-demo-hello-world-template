{
  "name": "${{ values.name }}",
  "version": "0.1.0",
  "description": "${{ values.description }}",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test src/*.test.js",
    "coverage": "c8 --reporter=json-summary --reporter=text node --test src/*.test.js",
    "lint": "eslint src"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "express": "^5.2.1",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "eslint": "^10.10.0"
  }
}
